<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 개인 주행 데이터는 차량 안에서만 처리한다. Pleos TTS/STT/LLM AAR이 SERVER 모드용으로 선언한
         INTERNET 권한을 제거해 외부 전송 경로 자체를 막는다(틈은 ON_DEVICE 모드만 쓴다).
         TODO(verify-sdk): ON_DEVICE 모드가 INTERNET 없이 동작하는지 실차/에뮬레이터 확인 필요 -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 부하 인지 API 권한 정의(이 앱이 소유). 검토 내용은 README '부하 인지 API 권한' 참고. -->
    <permission
        android:name="app.teum.permission.READ_LOAD_STATE"
        android:description="@string/perm_read_load_desc"
        android:label="@string/perm_read_load_label"
        android:protectionLevel="normal" />
    <permission
        android:name="app.teum.permission.SUBMIT_MESSAGE"
        android:description="@string/perm_submit_desc"
        android:label="@string/perm_submit_label"
        android:protectionLevel="dangerous" />

    <application
        android:name=".TeumApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_teum"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teum">

        <!-- AAOS 표준 Car API. 런타임에 시스템이 제공한다. 없으면 시나리오 모드로 동작. -->
        <uses-library android:name="android.car" android:required="false" />

        <!-- 주행 중 화면: 운전 중 표시되므로 distractionOptimized 선언 -->
        <activity
            android:name=".ui.DrivingActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 동승자 화면(쉿 신호등): 주행 중 표시 -->
        <activity
            android:name=".ui.PassengerActivity"
            android:exported="false">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 설정(텍스트 입력 있음)·브리핑(스크롤 목록)·디버그는 정차 중에만: distractionOptimized 미선언 -->
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.BriefingActivity" android:exported="false" />

        <service
            android:name=".service.LoadEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="driver-load-aware communication manager: computes driving load from vehicle signals and gates voice/notifications while the vehicle is on" />
        </service>

        <!-- 부하 인지 API(바운드 서비스). READ_LOAD_STATE가 있어야 바인드할 수 있다. -->
        <service
            android:name=".service.TeumLoadAwareService"
            android:exported="true"
            android:permission="app.teum.permission.READ_LOAD_STATE">
            <intent-filter>
                <action android:name="app.teum.action.BIND_LOAD_AWARE" />
            </intent-filter>
        </service>

        <!-- 시동(부팅) 시 자동 시작 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
